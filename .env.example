# Copy to .env for local development. Never commit real credentials or care records.

DATABASE_URL="mysql://haven:haven@127.0.0.1:3307/haven"
AUTH_SECRET="replace-with-a-32-character-or-longer-secret"
HAVEN_DEMO_PASSWORD="HavenDemo!2026"
SESSION_COOKIE_NAME="haven_session"

# Where uploaded document files are stored. On cPanel this must be an absolute path OUTSIDE the
# application root, because each deployment overwrites that root. See docs/DEPLOYMENT.md.
UPLOAD_DIR="./uploads"
