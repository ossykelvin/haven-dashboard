    },
    {
      "page": "/api/auth/me",
      "regex": "^/api/auth/me(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/auth/me(?:/)?$"
    },
    {
      "page": "/api/bootstrap",
      "regex": "^/api/bootstrap(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/bootstrap(?:/)?$"
    },
    {
      "page": "/api/campuses",
      "regex": "^/api/campuses(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/campuses(?:/)?$"
    },
    {
      "page": "/api/documents/upload",
      "regex": "^/api/documents/upload(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/documents/upload(?:/)?$"
    },
    {
      "page": "/api/emails",
      "regex": "^/api/emails(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/emails(?:/)?$"
    },
    {
      "page": "/api/import",
      "regex": "^/api/import(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/import(?:/)?$"
    },
    {
      "page": "/api/mar",
      "regex": "^/api/mar(?:/)?$",
