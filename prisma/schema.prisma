generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AppRole {
  admin
  manager
  staff
  shift_lead
  admissions
  clerk
}

model AuthUser {
  id           String   @id @db.Char(36)
  email        String   @unique @db.VarChar(191)
  passwordHash String   @map("password_hash") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("tbl_auth_user")
}

model Organization {
  id                 String   @id @db.Char(36)
  name               String   @db.Text
  address            String?  @db.Text
  phone              String?  @db.Text
  email              String?  @db.Text
  website            String?  @db.Text
  cqcId              String?  @map("cqc_id") @db.Text
  logoUrl            String?  @map("logo_url") @db.Text
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  refNo              String?  @map("ref_no") @db.VarChar(64)
  mfaRequired        Boolean  @default(false) @map("mfa_required")
  passwordMinLength  Int      @default(12) @map("password_min_length")
  allowSelfProvision Boolean  @default(false) @map("allow_self_provision")
  emailFromName      String?  @map("email_from_name") @db.Text
  emailReplyTo       String?  @map("email_reply_to") @db.Text

  @@map("tbl_organization")
}

model Campus {
  id                          String    @id @db.Char(36)
  name                        String    @db.Text
  address                     String?   @db.Text
  phone                       String?   @db.Text
  email                       String?   @db.Text
  status                      String    @db.VarChar(32)
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")
  deletedAt                   DateTime? @map("deleted_at")
  isHeadOffice                Boolean   @default(false) @map("is_head_office")
  refNo                       String?   @map("ref_no") @db.VarChar(64)
  organizationId              String    @map("organization_id") @db.Char(36)
  notificationEmails          String?   @map("notification_emails") @db.Text
  appointmentReminderEnabled  Boolean   @default(false) @map("appointment_reminder_enabled")
  appointmentReminderDay1     Int       @default(7) @map("appointment_reminder_day1")
  appointmentReminderDay2     Int       @default(3) @map("appointment_reminder_day2")
  appointmentReminderDay3     Int       @default(1) @map("appointment_reminder_day3")

  @@index([organizationId])
  @@map("tbl_campus")
}

model Profile {
  id                     String    @id @db.Char(36)
  userId                 String    @unique @map("user_id") @db.Char(36)
  fullName               String?   @map("full_name") @db.Text
  avatarUrl              String?   @map("avatar_url") @db.Text
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  isActivated            Boolean   @default(true) @map("is_activated")
  deletedAt              DateTime? @map("deleted_at")
  campusId               String?   @map("campus_id") @db.Char(36)
  staffId                String?   @map("staff_id") @db.Char(36)
  accountType            String    @default("captive") @map("account_type") @db.VarChar(32)
  refNo                  String?   @map("ref_no") @db.VarChar(64)
  sessionTimeoutMinutes  Int       @default(30) @map("session_timeout_minutes")
  mfaBypass              Boolean   @default(false) @map("mfa_bypass")
  erasedAt               DateTime? @map("erased_at")

  @@index([campusId])
  @@map("tbl_profile")
}

model UserRole {
  id     String  @id @db.Char(36)
  userId String  @map("user_id") @db.Char(36)
  role   AppRole
  refNo  String? @map("ref_no") @db.VarChar(64)

  @@index([userId])
  @@map("tbl_user_role")
}

model UserCampusAccess {
  id        String   @id @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  campusId  String   @map("campus_id") @db.Char(36)
  grantedBy String?  @map("granted_by") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, campusId])
  @@map("tbl_user_campus_access")
}

model UserEmail {
  userId     String   @id @map("user_id") @db.Char(36)
  emailLower String   @map("email_lower") @db.VarChar(191)
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("tbl_user_email")
}

model RoleDefinition {
  name      String   @id @db.VarChar(32)
  isProtected Boolean @default(false) @map("is_protected")
  createdBy String?  @map("created_by") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("tbl_role_definition")
}

model RoleMenu {
  id        String   @id @db.Char(36)
  role      AppRole
  menuKey   String   @map("menu_key") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")
  refNo     String?  @map("ref_no") @db.VarChar(64)

  @@unique([role, menuKey])
  @@map("tbl_role_menu")
}

model MenuDefinition {
  id        String   @id @db.Char(36)
  menuKey   String   @unique @map("menu_key") @db.VarChar(64)
  label     String   @db.Text
  groupName String   @map("group_name") @db.VarChar(64)
  createdBy String?  @map("created_by") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")
  refNo     String?  @map("ref_no") @db.VarChar(64)

  @@map("tbl_menu_definition")
}

model Asset {
  id                    String    @id @db.Char(36)
  name                  String    @db.Text
  category              String    @db.VarChar(64)
  location              String?   @db.Text
  serialNumber          String?   @map("serial_number") @db.Text
  purchaseDate          DateTime? @map("purchase_date") @db.Date
  warrantyExpiry        DateTime? @map("warranty_expiry") @db.Date
  status                String    @db.VarChar(64)
  notes                 String?   @db.Text
  createdBy             String?   @map("created_by") @db.Char(36)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")
  purchaseCost          Decimal?  @map("purchase_cost") @db.Decimal(12, 2)
  nextInspectionDate    DateTime? @map("next_inspection_date") @db.Date
  maintenanceFrequency  String?   @map("maintenance_frequency") @db.VarChar(64)
  campusId              String    @map("campus_id") @db.Char(36)
  refNo                 String?   @map("ref_no") @db.VarChar(64)

  @@index([campusId, deletedAt])
  @@map("tbl_asset")
}

model StaffMember {
  id              String    @id @db.Char(36)
  fullName        String    @map("full_name") @db.Text
  email           String?   @db.Text
  phone           String?   @db.Text
  role            String    @db.VarChar(128)
  department      String?   @db.VarChar(128)
  employmentType  String?   @map("employment_type") @db.VarChar(64)
  startDate       DateTime? @map("start_date") @db.Date
  status          String    @db.VarChar(64)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  staffCode       String?   @map("staff_id") @db.VarChar(64)
  campusId        String    @map("campus_id") @db.Char(36)
  refNo           String?   @map("ref_no") @db.VarChar(64)
  isMedCompetent  Boolean   @default(false) @map("is_med_competent")

  @@index([campusId, deletedAt])
  @@map("tbl_staff")
}

model Resident {
  id                        String    @id @db.Char(36)
  fullName                  String    @map("full_name") @db.Text
  dateOfBirth               String?   @map("date_of_birth") @db.Text
  roomNumber                String?   @map("room_number") @db.VarChar(32)
  admissionDate             DateTime? @map("admission_date") @db.Date
  emergencyContactName      String?   @map("emergency_contact_name") @db.Text
  emergencyContactPhone     String?   @map("emergency_contact_phone") @db.Text
  medicalNotes              String?   @map("medical_notes") @db.Text
  status                    String    @db.VarChar(64)
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")
  deletedAt                 DateTime? @map("deleted_at")
  campusId                  String    @map("campus_id") @db.Char(36)
  refNo                     String?   @map("ref_no") @db.VarChar(64)
  residentCode              String?   @map("resident_id") @db.VarChar(64)
  emergencyContactNameHash  String?   @map("emergency_contact_name_hash") @db.Text
  nhsNumber                 String?   @map("nhs_number") @db.Text
  gpDetails                 String?   @map("gp_details") @db.Text
  address                   String?   @db.Text
  gender                    String?   @db.VarChar(32)
  mobility                  String?   @db.Text
  enquiryId                 String?   @map("enquiry_id") @db.Char(36)
  dementiaStatus            String?   @map("dementia_status") @db.Text
  currentSetting            String?   @map("current_setting") @db.Text
  fundingType               String?   @map("funding_type") @db.VarChar(64)
  riskFlags                 Json      @default("[]") @map("risk_flags")
  roomId                    String?   @map("room_id") @db.Char(36)

  @@index([campusId, deletedAt])
  @@map("tbl_resident")
}

model RotaShift {
  id         String    @id @db.Char(36)
  staffId    String    @map("staff_id") @db.Char(36)
  shiftDate  DateTime  @map("shift_date") @db.Date
  shiftStart String    @map("shift_start") @db.VarChar(8)
  shiftEnd   String    @map("shift_end") @db.VarChar(8)
  shiftType  String?   @map("shift_type") @db.VarChar(64)
  notes      String?   @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  campusId   String?   @map("campus_id") @db.Char(36)
  refNo      String?   @map("ref_no") @db.VarChar(64)

  @@index([campusId, shiftDate])
  @@map("tbl_rota")
}

model Incident {
  id               String    @id @db.Char(36)
  title            String    @db.Text
  description      String?   @db.Text
  incidentDate     DateTime  @map("incident_date")
  severity         String    @db.VarChar(32)
  status           String    @db.VarChar(32)
  location         String?   @db.Text
  reportedBy       String?   @map("reported_by") @db.Char(36)
  assignedTo       String?   @map("assigned_to") @db.Char(36)
  resolutionNotes  String?   @map("resolution_notes") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")
  campusId         String    @map("campus_id") @db.Char(36)
  refNo            String?   @map("ref_no") @db.VarChar(64)
  incidentType     String    @map("incident_type") @db.VarChar(64)
  reporterName     String?   @map("reporter_name") @db.Text
  witnessNames     String?   @map("witness_names") @db.Text
  actionTaken      String?   @map("action_taken") @db.Text
  notifyFamily     Boolean   @default(false) @map("notify_family")
  notifyDoctor     Boolean   @default(false) @map("notify_doctor")
  notifyManagement Boolean   @default(false) @map("notify_management")
  residentId       String?   @map("resident_id") @db.Char(36)

  @@index([campusId, deletedAt])
  @@map("tbl_incident")
}

model Risk {
  id             String    @id @db.Char(36)
  title          String    @db.Text
  description    String?   @db.Text
  category       String?   @db.VarChar(64)
  likelihood     String?   @db.VarChar(32)
  impact         String?   @db.VarChar(32)
  riskLevel      String?   @map("risk_level") @db.VarChar(32)
  status         String    @db.VarChar(32)
  mitigation     String?   @db.Text
  owner          String?   @db.Char(36)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  campusId       String    @map("campus_id") @db.Char(36)
  nextReviewDate DateTime? @map("next_review_date") @db.Date
  reminder7dSent Boolean   @default(false) @map("reminder_7d_sent")
  reminder1dSent Boolean   @default(false) @map("reminder_1d_sent")
  refNo          String?   @map("ref_no") @db.VarChar(64)
  reminder3dSent Boolean   @default(false) @map("reminder_3d_sent")

  @@index([campusId, deletedAt])
  @@map("tbl_risk")
}

model ComplianceCheck {
  id                   String    @id @db.Char(36)
  title                String    @db.Text
  category             String    @db.VarChar(64)
  dueDate              DateTime  @map("due_date") @db.Date
  completedDate        DateTime? @map("completed_date") @db.Date
  status               String    @db.VarChar(64)
  assignedTo           String?   @map("assigned_to") @db.Char(36)
  notes                String?   @db.Text
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  reminderDaysBefore   Int       @default(7) @map("reminder_days_before")
  escalationSent       Boolean   @default(false) @map("escalation_sent")
  reminderSent         Boolean   @default(false) @map("reminder_sent")
  dueNotificationSent  Boolean   @default(false) @map("due_notification_sent")
  deletedAt            DateTime? @map("deleted_at")
  campusId             String?   @map("campus_id") @db.Char(36)
  reminder7dSent       Boolean   @default(false) @map("reminder_7d_sent")
  reminder1dSent       Boolean   @default(false) @map("reminder_1d_sent")
  refNo                String?   @map("ref_no") @db.VarChar(64)
  reminder3dSent       Boolean   @default(false) @map("reminder_3d_sent")

  @@index([campusId, deletedAt])
  @@map("tbl_compliance_check")
}

model Audit {
  id            String    @id @db.Char(36)
  title         String    @db.Text
  auditDate     DateTime  @map("audit_date") @db.Date
  auditor       String?   @db.Text
  scope         String?   @db.Text
  findings      String?   @db.Text
  recommendations String? @db.Text
  status        String    @db.VarChar(64)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  campusId      String?   @map("campus_id") @db.Char(36)
  cqcResponses  Json      @default("{}") @map("cqc_responses")
  refNo         String?   @map("ref_no") @db.VarChar(64)

  @@index([campusId, deletedAt])
  @@map("tbl_audit")
}

model Notification {
  id            String   @id @db.Char(36)
  userId        String   @map("user_id") @db.Char(36)
  title         String   @db.Text
  message       String   @db.Text
  type          String   @db.VarChar(32)
  referenceId   String?  @map("reference_id") @db.Char(36)
  referenceType String?  @map("reference_type") @db.VarChar(64)
  isRead        Boolean  @default(false) @map("is_read")
  createdAt     DateTime @default(now()) @map("created_at")
  refNo         String?  @map("ref_no") @db.VarChar(64)

  @@index([userId, isRead])
  @@map("tbl_notification")
}

model Maintenance {
  id             String    @id @db.Char(36)
  title          String    @db.Text
  description    String?   @db.Text
  category       String    @db.VarChar(64)
  assetId        String?   @map("asset_id") @db.Char(36)
  frequency      String    @db.VarChar(64)
  lastCompleted  DateTime? @map("last_completed") @db.Date
  nextDue        DateTime  @map("next_due") @db.Date
  assignedTo     String?   @map("assigned_to") @db.Char(36)
  status         String    @db.VarChar(64)
  priority       String    @db.VarChar(32)
  notes          String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  campusId       String?   @map("campus_id") @db.Char(36)
  refNo          String?   @map("ref_no") @db.VarChar(64)
  reminder7dSent Boolean   @default(false) @map("reminder_7d_sent")
  reminder1dSent Boolean   @default(false) @map("reminder_1d_sent")
  reminder3dSent Boolean   @default(false) @map("reminder_3d_sent")

  @@index([campusId, deletedAt])
  @@map("tbl_maintenance")
}

model Training {
  id              String    @id @db.Char(36)
  title           String    @db.Text
  category        String    @db.VarChar(64)
  description     String?   @db.Text
  frequency       String    @db.VarChar(64)
  isMandatory     Boolean   @default(false) @map("is_mandatory")
  applicableRoles Json?     @map("applicable_roles")
  status          String    @db.VarChar(64)
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  externalLink    String?   @map("external_link") @db.Text
  refNo           String?   @map("ref_no") @db.VarChar(64)

  @@map("tbl_training")
}

model TrainingAssignment {
  id          String    @id @db.Char(36)
  trainingId  String    @map("training_id") @db.Char(36)
  staffId     String    @map("staff_id") @db.Char(36)
  assignedBy  String?   @map("assigned_by") @db.Char(36)
  assignedAt  DateTime  @default(now()) @map("assigned_at")
  dueDate     DateTime? @map("due_date") @db.Date
  status      String    @db.VarChar(64)
  completedAt DateTime? @map("completed_at")
  notes       String?   @db.Text
  campusId    String?   @map("campus_id") @db.Char(36)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  refNo       String?   @map("ref_no") @db.VarChar(64)

  @@index([staffId, campusId])
  @@map("tbl_training_assignment")
}

model Document {
  id            String    @id @db.Char(36)
  title         String    @db.Text
  category      String    @db.VarChar(64)
  documentType  String    @map("document_type") @db.VarChar(64)
  relatedModule String?   @map("related_module") @db.VarChar(64)
  relatedId     String?   @map("related_id") @db.Char(36)
  filePath      String    @map("file_path") @db.Text
  fileName      String    @map("file_name") @db.Text
  fileSize      BigInt?   @map("file_size")
  mimeType      String?   @map("mime_type") @db.VarChar(128)
  issueDate     DateTime? @map("issue_date") @db.Date
  expiryDate    DateTime? @map("expiry_date") @db.Date
  notes         String?   @db.Text
  uploadedBy    String?   @map("uploaded_by") @db.Char(36)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  campusId      String?   @map("campus_id") @db.Char(36)
  refNo         String?   @map("ref_no") @db.VarChar(64)

  @@index([campusId, deletedAt])
  @@map("tbl_document")
}

model ChatConversation {
  id        String   @id @db.Char(36)
  name      String?  @db.Text
  isGroup   Boolean  @default(false) @map("is_group")
  createdBy String   @map("created_by") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  refNo     String?  @map("ref_no") @db.VarChar(64)

  @@map("tbl_chat_conversation")
}

model ChatParticipant {
  id             String   @id @db.Char(36)
  conversationId String   @map("conversation_id") @db.Char(36)
  userId         String   @map("user_id") @db.Char(36)
  joinedAt       DateTime @default(now()) @map("joined_at")
  lastReadAt     DateTime @default(now()) @map("last_read_at")
  refNo          String?  @map("ref_no") @db.VarChar(64)

  @@unique([conversationId, userId])
  @@map("tbl_chat_participant")
}

model ChatMessage {
  id             String   @id @db.Char(36)
  conversationId String   @map("conversation_id") @db.Char(36)
  senderId       String   @map("sender_id") @db.Char(36)
  content        String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  refNo          String?  @map("ref_no") @db.VarChar(64)

  @@index([conversationId, createdAt])
  @@map("tbl_chat_message")
}

model EmailTemplate {
  id          String   @id @db.Char(36)
  name        String   @unique @db.VarChar(128)
  displayName String   @map("display_name") @db.Text
  subject     String   @db.Text
  html        String   @db.Text
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   String?  @map("created_by") @db.Char(36)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  refNo       String?  @map("ref_no") @db.VarChar(64)

  @@map("tbl_email_template")
}

model EmailSendLog {
  id             String   @id @db.Char(36)
  messageId      String?  @map("message_id") @db.Text
  templateName   String   @map("template_name") @db.VarChar(128)
  recipientEmail String   @map("recipient_email") @db.VarChar(191)
  status         String   @db.VarChar(32)
  errorMessage   String?  @map("error_message") @db.Text
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("email_send_log")
}

model EmailSendState {
  id                            Int       @id
  retryAfterUntil               DateTime? @map("retry_after_until")
  batchSize                     Int       @default(20) @map("batch_size")
  sendDelayMs                   Int       @default(250) @map("send_delay_ms")
  authEmailTtlMinutes           Int       @default(60) @map("auth_email_ttl_minutes")
  transactionalEmailTtlMinutes  Int       @default(1440) @map("transactional_email_ttl_minutes")
  updatedAt                     DateTime  @updatedAt @map("updated_at")

  @@map("email_send_state")
}

model SuppressedEmail {
  id        String   @id @db.Char(36)
  email     String   @unique @db.VarChar(191)
  reason    String   @db.Text
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("suppressed_emails")
}

model EmailUnsubscribeToken {
  id        String    @id @db.Char(36)
  token     String    @unique @db.VarChar(191)
  email     String    @unique @db.VarChar(191)
  createdAt DateTime  @default(now()) @map("created_at")
  usedAt    DateTime? @map("used_at")

  @@map("email_unsubscribe_tokens")
}

model CqcCheck {
  id        String    @id @db.Char(36)
  category  String    @db.VarChar(64)
  body      String    @map("text") @db.Text
  sortOrder Int       @map("sort_order")
  createdBy String?   @map("created_by") @db.Char(36)
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  refNo     String?   @map("ref_no") @db.VarChar(64)
  campusId  String    @map("campus_id") @db.Char(36)

  @@index([campusId, deletedAt])
  @@map("tbl_cqc_check")
}

model SavedReport {
  id          String    @id @db.Char(36)
  name        String    @db.Text
